    <link href="https://jsdelivr.net" rel="stylesheet">
    <style>
        :root {
            --verde-suave: #6b9080;
            --celeste-claro: #e8f1f2;
            --oscuro: #2b2d42;
        }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: var(--oscuro); }
        .hero { background: linear-gradient(135deg, #f4f9f9 0%, #cee5d0 100%); padding: 100px 0; }
        .btn-whatsapp { background-color: #25D366; color: white; font-weight: bold; border-radius: 50px; padding: 12px 30px; }
        .btn-whatsapp:hover { background-color: #1ebd58; color: white; }
        .card-servicio { border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: 0.3s; border-top: 5px solid var(--verde-suave); }
        .card-servicio:hover { transform: translateY(-5px); }
        footer { background-color: #f8f9fa; border-top: 1px solid #e9ecef; }
    </style>
</head>
<body>

    <!-- Menú de Navegación -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm">
        <div class="container">
